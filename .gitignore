# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env.local
.env*.local
.env.full

# secrets: service account keys, credentials, private keys
*-service-account*.json
*-firebase-admin*.json
*-sa.json
credentials.json
*.key
*.tsbuildinfo
next-env.d.ts

# local dev image storage (dev default, not used in prod container)
/data

# local research/reference assets (not part of the app)
/react-bits-ref
/spec-kit-assets
*.log
!package-lock.json
