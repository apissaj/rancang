# ── LLM gateway (wajib) ────────────────────────────────────────────────
# Gateway OpenAI-compatible. Contoh: 9Router, Ollama, vLLM, atau provider langsung.
# Jalankan di mesin yang sama → pakai localhost, bukan IP LAN.
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=your-key-here

# Daftar model yang muncul di model picker (pisahkan dengan koma).
LLM_MODELS=deepseek-v4-flash:free,deepseek-v4.1-flash:free

# Model default. ID harus ada di LLM_MODELS di atas.
LLM_DEFAULT_MODEL=deepseek-v4-flash:free

NODE_ENV=production

# ── MCP server (opsional) ──────────────────────────────────────────────
# Folder penyimpanan blueprint yang dibaca agent. Default: ~/.rancang
# RANCANG_HOME=

# Port transport HTTP MCP. Default: 3110
# RANCANG_MCP_PORT=

# ── Google Sign-In (opsional) ──────────────────────────────────────────
# App jalan penuh secara anonim (localStorage) kalau dikosongkan.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firestore session sync (opsional) ──────────────────────────────────
# Butuh config Firebase di atas juga.
FIREBASE_SERVICE_ACCOUNT_JSON=
